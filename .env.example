# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tganki
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF
# HTTP port for the Hono server
PORT=3000
# Public https origin. Set it to run in webhook mode; leave empty for long polling.
PUBLIC_URL=
# Secret used in the webhook path and the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to run /admin
ADMIN_TG_IDS=
# Enforce Free-plan limits (own decks / notes). Off by default.
PRO_ENABLED=false
NODE_ENV=development
LOG_LEVEL=info
