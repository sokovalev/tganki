# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tganki
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF
# HTTP port for the Hono server
PORT=3000
# Public https origin. Set it to run in webhook mode; leave empty for long polling.
PUBLIC_URL=
# Secret used in the webhook path and the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to run /admin
ADMIN_TG_IDS=
# Enforce Free-plan limits (own decks / notes / AI generations). Off by default.
PRO_ENABLED=false
# /pro prices in Telegram Stars. Blank = the defaults below (SPEC 9.2).
PRO_PRICE_MONTH=199
PRO_PRICE_YEAR=1499
PRO_PRICE_LIFETIME=2999
# OpenRouter key. Set it to turn on AI card generation (SPEC 4.1a); empty = manual input only.
OPENROUTER_API_KEY=
# Model used for card generation
LLM_MODEL=google/gemini-3.7-flash
# Reasoning effort for models that support it: low | medium | high. Empty = do not send it.
LLM_REASONING_EFFORT=
# Per-attempt timeout for a generation call, ms
LLM_TIMEOUT_MS=15000
# OpenRouter base URL override (proxy or mock)
LLM_BASE_URL=
NODE_ENV=development
LOG_LEVEL=info
